{
  "name": "lampa-3d-movies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 3D movie discovery extension for LAMPA",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "esbuild src/lampa/entry.js --bundle --format=iife --target=es2017 --outfile=dist/lampa-3d-movies.js"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "esbuild": "^0.25.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  }
}
